# Optional AdSense integration. Keep disabled until consent and policy setup is verified.
ADSENSE_ENABLED=false
# Set true only after a Google-certified CMP with the required IAB TCF integration is published and verified.
ADSENSE_CMP_READY=false
# Use the real AdSense client ID from the Vercel environment; never commit the value.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Tag Manager (GTM) Container ID
NEXT_PUBLIC_GTM_ID=GTM-5RFHKJJJ

# Google Analytics 4 (GA4) Measurement ID (Configured inside GTM)
NEXT_PUBLIC_GA_ID=G-HGE2T2J8ZT

# Public Site URL (e.g. https://totthobox.com or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Google OAuth (Must be set at build time for NEXT_PUBLIC_ in client bundles)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook OAuth
NEXT_PUBLIC_FACEBOOK_APP_ID=
